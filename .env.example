# Easiest install uses the latest stable release.
# For reproducible production deployments, replace `latest` with a release tag
# or immutable digest.
TRAKT_BRIDGE_IMAGE=ghcr.io/olivergiangvu/homedocker-trakt-bridge:latest

# Public HTTPS URL that your reverse proxy exposes. No trailing slash.
PUBLIC_BASE_URL=https://trakt.example.com

# Trakt application credentials from https://app.trakt.tv/settings/apps/api
TRAKT_CLIENT_ID=replace_me
TRAKT_CLIENT_SECRET=replace_me

# Generate both with: openssl rand -hex 32
BRIDGE_SECRET_KEY=replace_with_64_hex_chars
ADMIN_KEY=replace_with_64_hex_chars

# Container defaults
PORT=7000
DATA_DIR=/app/data
LOG_LEVEL=info
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh

# Recommended when Jellyfin-compatible clients may also use native Trakt.
PULL_IDENTITY_MODE=trakt

# Freshness controls. 300 seconds is the conservative public default.
# Lower values can improve freshness but
# should be staged and measured because AIOStreams has its own pull cadence and
# Trakt enforces API rate limits.
PULL_CACHE_TTL_SECONDS=300
PULL_HINT_SECONDS=300

# Serve a known matching state during temporary Trakt 429/5xx failures.
PULL_STALE_IF_ERROR_SECONDS=3600

# Safety cap for Trakt paginated reads.
PULL_MAX_PAGES=500

# Suppress same-kind per-episode echoes shortly after a successful bulk mark.
BULK_SINGLE_DEDUPE_SECONDS=300

# Suppress repeated semantic watched/unwatched writes for the same canonical
# Trakt movie/episode. This also prevents a completed scrobble stop followed by
# an explicit played mark from creating a second Trakt history entry.
# Set 0 only for diagnostics to disable this guard.
HISTORY_DEDUPE_SECONDS=300

# v1.4.0-rc.1 integrated candidate — conservative defaults.
# Bridge RC candidate and its one dashboard do not require any Gateway listener.
# These flags MUST remain disabled for the first RC/rollback rehearsal.
# Do not point Odin/Remux/Trellis/Strand at the Gateway or expose port 7101.
JELLYFIN_GATEWAY_ENABLED=false
JELLYFIN_GATEWAY_LEGACY_IMPORT=off
JELLYFIN_GATEWAY_RESUME_PASSTHROUGH=false
# RC.2: conservative NextUp first-page support; full/later/uncertain pages
# remain byte-identical AIO passthrough. Gateway itself stays OFF by default.
JELLYFIN_GATEWAY_FIRST_PAGE_MODE=short_first_page_only
# The Gateway listener/backend is provisioned ONCE by the operator.
# After it is listening and same-user identity is configured, the Unified UI
# can turn NextUp IDENTITY FILTERING ON/OFF immediately without a restart.
# Filter starts OFF and remains OFF across restarts until explicitly enabled
# from authenticated admin/profile UI. No client route or nginx is changed by
# the UI toggle.
# This deployment uses ONE selected upstream at a time (not a fan-out proxy):
# aiostreams (primary), remux or jellyfin (Jellyfin API compatibility required).
JELLYFIN_GATEWAY_SOURCE_KIND=aiostreams
# Configure only after separately reviewed exact Jellyfin-user/profile mapping:
# JELLYFIN_GATEWAY_PORT=7101
# JELLYFIN_GATEWAY_UPSTREAM_URL=http://aiostreams:3000/jellyfin
# JELLYFIN_GATEWAY_AIO_USER_ID=not_for_public_env_examples
# JELLYFIN_GATEWAY_PROFILE_ID=not_for_public_env_examples

# v1.4 draft NextUp-only upstream first-response deadline.
# Default: 8000ms; opt-in experimental canary maximum: 20000ms.
# Does NOT change per-series /Users/Me metadata or Resume deadlines,
# the client HTTP timeout, or nginx proxy_read_timeout.
# Do not increase production until an authenticated replay is qualified.
JELLYFIN_GATEWAY_NEXTUP_TIMEOUT_MS=8000

# Optional Bridge-side AIO local-state reconciler.
# detect = AIO SQLite observation only.
# compare = detect + authenticated Trakt GET comparison; still never writes Trakt.
# Leave off by default until explicitly qualifying a reconciler mode.
AIO_RECONCILER_MODE=off
AIO_DB_PATH=/aio-data/db.sqlite
# RC2 opt-in guard for a proven AIO/Jellyfin UserData echo where Played=false
# is queued as unplayed even though the same request leaves a positive local resume point.
# The guard is fail-open and requires matching delivered playback evidence.
AIO_UNPLAYED_ECHO_GUARD=false

# RC4 opt-in history-lineage guard. Preserves isolated manual marks and native
# bulk marks while suppressing deterministic AIO state echoes and rapid
# single-mark sync fanout. Requires the same read-only AIO database mount.
AIO_HISTORY_ECHO_GUARD=false
AIO_HISTORY_EVIDENCE_INTERVAL_MS=1000
AIO_HISTORY_EVIDENCE_LOOKBACK_SECONDS=120
AIO_HISTORY_EVIDENCE_MAX_ROWS=500
AIO_HISTORY_COHORT_WINDOW_MS=10000
AIO_HISTORY_COHORT_MIN_ITEMS=3
CANONICAL_HISTORY_MAX_AGE_SECONDS=900
# RC6 opt-in: for a single unguarded played/unplayed event, re-verify a stale
# canonical snapshot through Trakt before deciding whether it is an echo.
# OFF by default until canary API load and false-positive rate are evaluated.
CANONICAL_ON_DEMAND_VERIFY=false
CANONICAL_VERIFY_MIN_INTERVAL_SECONDS=120

AIO_RECONCILE_INTERVAL_SECONDS=15
AIO_RECONCILE_GRACE_SECONDS=30
# A candidate must stay unchanged for this long before it is considered settled.
AIO_RECONCILE_QUIET_SECONDS=300
# A later UserData row may arrive after a valid playback stop. Coverage only
# accepts delivered HomeDocker playback within this bounded lookback and with
# an equivalent positive playback position.
AIO_RECONCILE_COVERAGE_LOOKBACK_SECONDS=180
AIO_RECONCILE_POSITION_TOLERANCE_MS=2000
# Match only the HomeDocker sink; instance ID is optional but recommended when known.
AIO_RECONCILE_SINK_NAME=homedocker-trakt-bridge
# AIO_RECONCILE_SINK_INSTANCE_ID=e3fe3b0
AIO_RECONCILE_MAX_ROWS=100

# Optional. Leave unset to use the application's versioned default User-Agent.
# USER_AGENT=My-Trakt-Bridge/1.0

# Production image. Pin a release tag or exact digest for reproducible deploys.
TRAKT_BRIDGE_IMAGE=ghcr.io/olivergiangvu/homedocker-trakt-bridge:0.9.2

# Public HTTPS URL that nginx exposes for this bridge. No trailing slash.
PUBLIC_BASE_URL=https://traktbridge.example.com

# Trakt application credentials from https://app.trakt.tv/settings/apps/api
TRAKT_CLIENT_ID=replace_me
TRAKT_CLIENT_SECRET=replace_me

# Generate both with: openssl rand -hex 32
BRIDGE_SECRET_KEY=replace_with_64_hex_chars
ADMIN_KEY=replace_with_64_hex_chars

# Container defaults
PORT=7000
DATA_DIR=/app/data
LOG_LEVEL=info
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh

# Pull identity compatibility mode.
# trakt      = preserve the IMDb spelling returned by Trakt on pull; recommended
#              when clients such as Strand also use native Trakt directly.
# aiostreams = rewrite Trakt IMDb to the playback-learned AIOStreams-preferred
#              IMDb spelling; preserves the v0.3.5 behavior.
PULL_IDENTITY_MODE=trakt

# Freshness controls are split. v0.9.2 adds rate-limit-aware pacing/cooldown so
# a low cache TTL can later be tuned without repeatedly hammering Trakt.
PULL_CACHE_TTL_SECONDS=60

# PULL_HINT_SECONDS is advertised as watchState.pull.ttlSeconds in the manifest.
# AIOStreams also has its own WATCH_STATE_PULL_TTL / background pull cadence, so
# end-to-end freshness is bounded by both services.
PULL_HINT_SECONDS=60

# Legacy compatibility only. If PULL_CACHE_TTL_SECONDS is absent, an existing
# PULL_TTL_SECONDS value is still accepted during upgrade.
# PULL_TTL_SECONDS=900

# When Trakt returns a transient 429/5xx, an already-known matching version may
# be served from stale cache for this long. v0.9.2 also persists the active
# Retry-After cooldown in bridge.db so restart/recreate does not immediately
# resume hitting Trakt inside the same rate-limit window.
PULL_STALE_IF_ERROR_SECONDS=3600

# Safety cap for Trakt paginated reads. 500 pages is intentionally far above
# normal personal histories/watchlists while still preventing accidental loops.
PULL_MAX_PAGES=500

# Some Jellyfin-compatible clients may echo per-episode played/unplayed calls
# shortly after AIOStreams has already delivered the same whole-season/show bulk
# mark. Suppress only same-kind episode echoes covered by that successful bulk.
BULK_SINGLE_DEDUPE_SECONDS=300

# Optional override. A proper User-Agent is recommended by Trakt.
USER_AGENT=HomeDocker-Trakt-Bridge/0.9.2

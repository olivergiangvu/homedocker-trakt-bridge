# Separate, non-writing HomeDocker Jellyfin NextUp canary.
# Does NOT start Bridge, mount its DB or ship OAuth credentials.
# Pin official node runtime by digest, matching reviewed Bridge base.
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
WORKDIR /app
COPY --chown=node:node package.json ./package.json
COPY --chown=node:node src ./src
USER node
ENV NODE_ENV=production JELLYFIN_GATEWAY_PORT=7101 GATEWAY_PROOF_FILE=/run/identity-proof.json
EXPOSE 7101
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:7101/health || exit 1
CMD ["node", "src/gateway-canary-entry.mjs"]
